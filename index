<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <title>合约仓位风险规划工具</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root {
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text",
        system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color-scheme: dark light;
      --bg: #05070b;
      --card-bg: #0c1016;
      --card-border: #1b2230;
      --accent: #f9b44c;
      --accent-soft: rgba(249, 180, 76, 0.12);
      --text-main: #f5f7fb;
      --text-muted: #9098ad;
      --danger: #ff6b6b;
      --success: #3acb7a;
      --warning: #ffd369;
    }
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at top, #101524 0, #05070b 55%);
      color: var(--text-main);
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 32px 16px 48px;
    }
    .app {
      width: 100%;
      max-width: 1120px;
    }
    .header {
      margin-bottom: 24px;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
    }
    .title {
      font-size: 24px;
      font-weight: 600;
      letter-spacing: 0.04em;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .title-pill {
      font-size: 11px;
      padding: 3px 8px;
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--accent);
      border: 1px solid rgba(249, 180, 76, 0.35);
    }
    .subtitle {
      font-size: 13px;
      color: var(--text-muted);
    }
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr);
      gap: 20px;
    }
    @media (max-width: 900px) {
      .layout {
        grid-template-columns: 1fr;
      }
    }
    .card {
      background: linear-gradient(145deg, rgba(255,255,255,0.02), transparent);
      border-radius: 18px;
      border: 1px solid var(--card-border);
      padding: 18px 18px 16px;
      box-shadow: 0 16px 40px rgba(0,0,0,0.45);
      backdrop-filter: blur(16px);
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 10px;
    }
    .card-title {
      font-size: 15px;
      font-weight: 550;
    }
    .card-tag {
      font-size: 11px;
      color: var(--text-muted);
    }

    /* 表单 */
    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px 14px;
      margin-top: 8px;
    }
    .form-row-full {
      grid-column: 1 / -1;
    }
    label {
      display: block;
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 4px;
    }
    select,
    input[type="number"] {
      width: 100%;
      border-radius: 10px;
      border: 1px solid rgba(144,152,173,0.5);
      background: radial-gradient(circle at top left, #1a2334 0, #0a0d13 60%);
      color: var(--text-main);
      padding: 7px 10px;
      font-size: 13px;
      outline: none;
      transition: border 0.15s, box-shadow 0.15s, background 0.2s;
      appearance: none;
    }
    select:focus,
    input[type="number"]:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 1px rgba(249, 180, 76, 0.4);
      background: radial-gradient(circle at top left, #202a3e 0, #070a10 65%);
    }
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }

    .side-toggle {
      display: inline-flex;
      border-radius: 999px;
      background: #05070b;
      padding: 2px;
      border: 1px solid var(--card-border);
      gap: 2px;
    }
    .side-toggle button {
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-size: 12px;
      padding: 5px 12px;
      border-radius: 999px;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }
    .side-toggle button.active {
      background: linear-gradient(135deg, #2f4cff, #4ac3ff);
      color: #ffffff;
    }

    .btn-primary {
      margin-top: 10px;
      width: 100%;
      padding: 9px 14px;
      border-radius: 999px;
      border: none;
      background: linear-gradient(135deg, #f5b04a, #ffdd80);
      color: #141414;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      box-shadow: 0 14px 30px rgba(0,0,0,0.55);
      transition: transform 0.1s ease-out, box-shadow 0.1s ease-out;
    }
    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 18px 40px rgba(0,0,0,0.65);
    }
    .btn-primary:active {
      transform: translateY(0);
      box-shadow: 0 10px 24px rgba(0,0,0,0.5);
    }

    .hint {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 6px;
      line-height: 1.5;
    }

    /* 结果卡片 */
    .scenario-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 12px;
    }
    .scenario-card {
      border-radius: 14px;
      border: 1px solid var(--card-border);
      padding: 12px 12px 10px;
      background: radial-gradient(circle at top, rgba(255,255,255,0.03), transparent);
      position: relative;
      overflow: hidden;
    }
    .scenario-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 6px;
    }
    .scenario-title {
      font-size: 13px;
      font-weight: 550;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .chip {
      font-size: 10px;
      padding: 1px 6px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.07);
      color: var(--text-muted);
    }
    .chip.safe {
      border-color: rgba(58,203,122,0.4);
      color: var(--success);
      background: rgba(58,203,122,0.08);
    }
    .chip.risky {
      border-color: rgba(255,107,107,0.5);
      color: var(--danger);
      background: rgba(255,107,107,0.08);
    }
    .scenario-main {
      font-size: 12px;
      margin-bottom: 4px;
    }
    .scenario-main strong {
      font-size: 13px;
    }
    .scenario-section-title {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 6px;
      margin-bottom: 2px;
    }
    .kv-row {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      padding: 1px 0;
    }
    .kv-row span:last-child {
      font-variant-numeric: tabular-nums;
    }
    .accent-number {
      color: var(--accent);
    }
    .text-success {
      color: var(--success);
    }
    .text-danger {
      color: var(--danger);
    }
    .text-warning {
      color: var(--warning);
    }
    .scenario-footer {
      margin-top: 6px;
      font-size: 10px;
      color: var(--text-muted);
    }
    .badge-symbol {
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 999px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
    }
  </style>
</head>
<body>
  <div class="app">
    <header class="header">
      <div>
        <div class="title">
          合约仓位风险规划
          <span class="title-pill">BTC · ETH · BNB · USDT-M 永续</span>
        </div>
        <div class="subtitle">
          输入你的本金、进场 / 止损 / 止盈价格与杠杆，自动生成三档仓位方案：较安全 · 中等风险 · 激进不建议。
        </div>
      </div>
      <div class="badge-symbol" id="symbolBadge">BTCUSDT · 全仓风险估算</div>
    </header>

    <div class="layout">
      <!-- 输入区 -->
      <section class="card">
        <div class="card-header">
          <div class="card-title">基础参数</div>
          <div class="card-tag">仅做风险预估，忽略手续费与资金费</div>
        </div>

        <form id="plannerForm">
          <div class="form-grid">
            <div>
              <label for="symbol">交易对</label>
              <select id="symbol">
                <option value="BTCUSDT">BTCUSDT</option>
                <option value="ETHUSDT">ETHUSDT</option>
                <option value="BNBUSDT">BNBUSDT</option>
              </select>
            </div>

            <div>
              <label>方向</label>
              <div class="side-toggle" id="sideToggle">
                <button type="button" data-side="long" class="active">做多</button>
                <button type="button" data-side="short">做空</button>
              </div>
              <input type="hidden" id="side" value="long" />
            </div>

            <div>
              <label for="balance">本金 (USDT)</label>
              <input type="number" id="balance" value="10000" min="1" step="1" />
            </div>

            <div>
              <label for="leverage">杠杆倍数</label>
              <input type="number" id="leverage" value="50" min="1" step="1" />
            </div>

            <div>
              <label for="entryPrice">进场价格</label>
              <input type="number" id="entryPrice" placeholder="例如 90200" step="0.01" />
            </div>

            <div>
              <label for="stopLossPrice">止损价格</label>
              <input type="number" id="stopLossPrice" placeholder="例如 91500" step="0.01" />
            </div>

            <div class="form-row-full">
              <label for="takeProfitPrice">止盈价格</label>
              <input type="number" id="takeProfitPrice" placeholder="例如 87500" step="0.01" />
            </div>
          </div>

          <button type="submit" class="btn-primary">计算三档仓位方案</button>
          <div class="hint">
            · 假设账户只持有这一笔仓位（全仓），用于估算强平价与可承受波动。<br/>
            · 维持保证金公式：<strong>MM = 名义价值 × MMR + 速算额</strong>，MMR 与速算额来自你给定的阶梯表。
          </div>
        </form>
      </section>

      <!-- 结果区 -->
      <section class="card">
        <div class="card-header">
          <div class="card-title">方案结果</div>
          <div class="card-tag">方案 A · B · C 按使用最大可开名义价值的 20% / 30% / 40% 估算</div>
        </div>

        <div class="scenario-grid">
          <div class="scenario-card" id="scenarioA">
            <div class="scenario-header">
              <div class="scenario-title">
                方案 A
                <span class="chip safe">较安全 · 保守</span>
              </div>
              <div id="scenarioA_notional" class="accent-number">—</div>
            </div>
            <div class="scenario-main">
              <div>名义价值：<strong id="scenarioA_notional_detail">—</strong></div>
            </div>
            <div class="scenario-section-title">保证金与强平</div>
            <div class="kv-row">
              <span>初始保证金 (IM)</span><span id="scenarioA_im">—</span>
            </div>
            <div class="kv-row">
              <span>维持保证金 (MM)</span><span id="scenarioA_mm">—</span>
            </div>
            <div class="kv-row">
              <span>预估强平价格</span><span id="scenarioA_liq">—</span>
            </div>
            <div class="kv-row">
              <span>可承受反向波动</span><span id="scenarioA_move">—</span>
            </div>

            <div class="scenario-section-title">止盈 / 止损盈亏</div>
            <div class="kv-row">
              <span>到止盈</span><span id="scenarioA_tp">—</span>
            </div>
            <div class="kv-row">
              <span>到止损</span><span id="scenarioA_sl">—</span>
            </div>
            <div class="scenario-footer" id="scenarioA_note">—</div>
          </div>

          <div class="scenario-card" id="scenarioB">
            <div class="scenario-header">
              <div class="scenario-title">
                方案 B
                <span class="chip">中等风险</span>
              </div>
              <div id="scenarioB_notional" class="accent-number">—</div>
            </div>
            <div class="scenario-main">
              <div>名义价值：<strong id="scenarioB_notional_detail">—</strong></div>
            </div>
            <div class="scenario-section-title">保证金与强平</div>
            <div class="kv-row">
              <span>初始保证金 (IM)</span><span id="scenarioB_im">—</span>
            </div>
            <div class="kv-row">
              <span>维持保证金 (MM)</span><span id="scenarioB_mm">—</span>
            </div>
            <div class="kv-row">
              <span>预估强平价格</span><span id="scenarioB_liq">—</span>
            </div>
            <div class="kv-row">
              <span>可承受反向波动</span><span id="scenarioB_move">—</span>
            </div>

            <div class="scenario-section-title">止盈 / 止损盈亏</div>
            <div class="kv-row">
              <span>到止盈</span><span id="scenarioB_tp">—</span>
            </div>
            <div class="kv-row">
              <span>到止损</span><span id="scenarioB_sl">—</span>
            </div>
            <div class="scenario-footer" id="scenarioB_note">—</div>
          </div>

          <div class="scenario-card" id="scenarioC">
            <div class="scenario-header">
              <div class="scenario-title">
                方案 C
                <span class="chip risky">激进 · 不建议</span>
              </div>
              <div id="scenarioC_notional" class="accent-number">—</div>
            </div>
            <div class="scenario-main">
              <div>名义价值：<strong id="scenarioC_notional_detail">—</strong></div>
            </div>
            <div class="scenario-section-title">保证金与强平</div>
            <div class="kv-row">
              <span>初始保证金 (IM)</span><span id="scenarioC_im">—</span>
            </div>
            <div class="kv-row">
              <span>维持保证金 (MM)</span><span id="scenarioC_mm">—</span>
            </div>
            <div class="kv-row">
              <span>预估强平价格</span><span id="scenarioC_liq">—</span>
            </div>
            <div class="kv-row">
              <span>可承受反向波动</span><span id="scenarioC_move">—</span>
            </div>

            <div class="scenario-section-title">止盈 / 止损盈亏</div>
            <div class="kv-row">
              <span>到止盈</span><span id="scenarioC_tp">—</span>
            </div>
            <div class="kv-row">
              <span>到止损</span><span id="scenarioC_sl">—</span>
            </div>
            <div class="scenario-footer" id="scenarioC_note">—</div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <script>
    // ------------------ MMR 表配置（BTC / ETH / BNB 共用） ------------------
    const mmrTiers = [
      { min: 0, max: 10000, maxLev: 75, mmr: 0.005, quick: 0 },
      { min: 10000, max: 100000, maxLev: 50, mmr: 0.01, quick: 50 },
      { min: 100000, max: 160000, maxLev: 40, mmr: 0.015, quick: 550 },
      { min: 160000, max: 800000, maxLev: 25, mmr: 0.02, quick: 1350 },
      { min: 800000, max: 1600000, maxLev: 20, mmr: 0.025, quick: 5350 },
      { min: 1600000, max: 8000000, maxLev: 10, mmr: 0.05, quick: 45350 },
      { min: 8000000, max: 16000000, maxLev: 5, mmr: 0.10, quick: 445350 },
      { min: 16000000, max: 20000000, maxLev: 4, mmr: 0.125, quick: 845350 },
      { min: 20000000, max: 40000000, maxLev: 2, mmr: 0.25, quick: 3345350 },
      { min: 40000000, max: 80000000, maxLev: 1, mmr: 0.5, quick: 13345350 }
    ];

    // 如果未来 BTC/ETH/BNB 想用不同表，可以在这里拆分
    const symbolMMR = {
      BTCUSDT: mmrTiers,
      ETHUSDT: mmrTiers,
      BNBUSDT: mmrTiers
    };

    function getTier(symbol, notional) {
      const tiers = symbolMMR[symbol] || mmrTiers;
      for (let i = 0; i < tiers.length; i++) {
        const t = tiers[i];
        const isLast = i === tiers.length - 1;
        if (
          notional >= t.min &&
          (notional < t.max || (isLast && notional <= t.max))
        ) {
          return t;
        }
      }
      // 默认用最高层
      return tiers[tiers.length - 1];
    }

    function formatUsd(v, decimals = 2) {
      if (!isFinite(v)) return "—";
      return v.toFixed(decimals) + " USDT";
    }

    function formatPct(v, decimals = 2) {
      if (!isFinite(v)) return "—";
      return (v * 100).toFixed(decimals) + "%";
    }

    function computeScenario({
      symbol,
      side,
      balance,
      leverage,
      entry,
      sl,
      tp,
      multiplier
    }) {
      const maxNotional = balance * leverage;
      let notional = maxNotional * multiplier;

      if (!isFinite(notional) || notional <= 0) {
        return { valid: false };
      }

      // 保证不超过我们阶梯的最大值
      const tiers = symbolMMR[symbol] || mmrTiers;
      const maxTierNotional = tiers[tiers.length - 1].max;
      if (notional > maxTierNotional) notional = maxTierNotional;

      const tier = getTier(symbol, notional);
      const im = notional / leverage;
      const mm = notional * tier.mmr + tier.quick;

      // 预估强平价（全仓，忽略手续费）
      // Equity_open = balance
      // Long: balance + N*(Pliq - E)/E = MM
      // Short: balance + N*(E - Pliq)/E = MM
      let liqPrice;
      if (balance <= mm) {
        liqPrice = NaN;
      } else if (side === "long") {
        liqPrice = entry + (entry * (mm - balance)) / notional;
      } else {
        liqPrice = entry - (entry * (mm - balance)) / notional;
      }

      // 最大可承受反向波动（价格偏离进场的幅度）
      let adversePct = NaN;
      if (isFinite(liqPrice)) {
        if (side === "long") {
          adversePct = (entry - liqPrice) / entry;
        } else {
          adversePct = (liqPrice - entry) / entry;
        }
      }

      // 止盈 / 止损盈亏
      let pnlTp = NaN;
      let pnlSl = NaN;
      if (side === "long") {
        pnlTp = notional * (tp - entry) / entry;
        pnlSl = notional * (sl - entry) / entry;
      } else {
        pnlTp = notional * (entry - tp) / entry;
        pnlSl = notional * (entry - sl) / entry;
      }

      const pnlTpPctOnBalance = pnlTp / balance;
      const pnlSlPctOnBalance = pnlSl / balance;

      return {
        valid: true,
        notional,
        im,
        mm,
        liqPrice,
        adversePct,
        pnlTp,
        pnlSl,
        pnlTpPctOnBalance,
        pnlSlPctOnBalance,
        tier
      };
    }

    function renderScenario(prefix, scenario) {
      const setText = (id, text, cls) => {
        const el = document.getElementById(prefix + "_" + id);
        if (!el) return;
        el.textContent = text;
        el.classList.remove("text-success", "text-danger", "text-warning");
        if (cls) el.classList.add(cls);
      };

      if (!scenario.valid) {
        setText("notional", "—");
        setText("notional_detail", "—");
        setText("im", "—");
        setText("mm", "—");
        setText("liq", "—");
        setText("move", "—");
        setText("tp", "—");
        setText("sl", "—");
        setText("note", "请输入有效参数");
        return;
      }

      setText("notional", formatUsd(scenario.notional, 0));
      setText("notional_detail", formatUsd(scenario.notional, 2));

      setText("im", formatUsd(scenario.im, 2));
      setText("mm", formatUsd(scenario.mm, 2));

      if (isFinite(scenario.liqPrice)) {
        setText("liq", scenario.liqPrice.toFixed(2));
      } else {
        setText("liq", "接近强平 · 无法估算", "text-danger");
      }

      if (isFinite(scenario.adversePct)) {
        const pctStr = formatPct(scenario.adversePct, 2);
        const cls =
          scenario.adversePct >= 0.06
            ? "text-success"
            : scenario.adversePct >= 0.03
            ? "text-warning"
            : "text-danger";
        setText("move", pctStr, cls);
      } else {
        setText("move", "—");
      }

      // 止盈 / 止损
      const tpCls = scenario.pnlTp >= 0 ? "text-success" : "text-danger";
      const slCls = scenario.pnlSl >= 0 ? "text-success" : "text-danger";

      setText(
        "tp",
        `${scenario.pnlTp >= 0 ? "+" : ""}${formatUsd(
          scenario.pnlTp,
          2
        )} (${formatPct(scenario.pnlTpPctOnBalance, 2)})`,
        tpCls
      );
      setText(
        "sl",
        `${scenario.pnlSl >= 0 ? "+" : ""}${formatUsd(
          scenario.pnlSl,
          2
        )} (${formatPct(scenario.pnlSlPctOnBalance, 2)})`,
        slCls
      );

      // 备注
      let note = `当前所在层级：名义 ${scenario.tier.min.toLocaleString()} - ${scenario.tier.max.toLocaleString()}，维持保证金率 ${(scenario.tier.mmr*100).toFixed(2)}%，速算额 ${scenario.tier.quick.toLocaleString()} USDT。`;
      if (scenario.adversePct < 0.02) {
        note += " 抗风险能力极弱，稍有波动就可能接近平仓。";
      } else if (scenario.adversePct < 0.04) {
        note += " 抗风险一般，适合短线或严格止损。";
      } else {
        note += " 抗风险相对充足，可结合策略灵活持仓。";
      }
      setText("note", note);
    }

    // 侧边切换
    const sideToggle = document.getElementById("sideToggle");
    sideToggle.addEventListener("click", (e) => {
      if (e.target.tagName !== "BUTTON") return;
      const side = e.target.getAttribute("data-side");
      document.getElementById("side").value = side;
      [...sideToggle.querySelectorAll("button")].forEach((btn) =>
        btn.classList.toggle("active", btn === e.target)
      );
    });

    const symbolSelect = document.getElementById("symbol");
    symbolSelect.addEventListener("change", () => {
      const symbol = symbolSelect.value;
      document.getElementById(
        "symbolBadge"
      ).textContent = `${symbol} · 全仓风险估算`;
    });

    document
      .getElementById("plannerForm")
      .addEventListener("submit", function (e) {
        e.preventDefault();
        const symbol = document.getElementById("symbol").value;
        const side = document.getElementById("side").value;
        const balance = parseFloat(document.getElementById("balance").value);
        const leverage = parseFloat(document.getElementById("leverage").value);
        const entry = parseFloat(document.getElementById("entryPrice").value);
        const sl = parseFloat(document.getElementById("stopLossPrice").value);
        const tp = parseFloat(document.getElementById("takeProfitPrice").value);

        const baseParams = {
          symbol,
          side,
          balance,
          leverage,
          entry,
          sl,
          tp
        };

        const scenarioA = computeScenario({ ...baseParams, multiplier: 0.2 });
        const scenarioB = computeScenario({ ...baseParams, multiplier: 0.3 });
        const scenarioC = computeScenario({ ...baseParams, multiplier: 0.4 });

        renderScenario("scenarioA", scenarioA);
        renderScenario("scenarioB", scenarioB);
        renderScenario("scenarioC", scenarioC);
      });
  </script>
</body>
</html>
